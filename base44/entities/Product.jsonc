{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "category": {
      "type": "string",
      "enum": [
        "snacks",
        "beverages",
        "dry_groceries",
        "fresh_products",
        "frozen_products"
      ],
      "description": "Product category"
    },
    "rayon": {
      "type": "string",
      "description": "Store section / Rayon"
    },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "Expiration date"
    },
    "quantity": {
      "type": "number",
      "description": "Quantity (optional)"
    },
    "order_status": {
      "type": "string",
      "enum": [
        "to_order",
        "ordered",
        "received"
      ],
      "description": "Restocking order status (only for expired products)"
    },
    "order_date": {
      "type": "string",
      "format": "date",
      "description": "Order date for restocking"
    }
  },
  "required": [
    "name",
    "category",
    "expiration_date"
  ]
}