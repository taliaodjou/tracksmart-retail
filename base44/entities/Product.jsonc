{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "category": {
      "type": "string",
      "enum": [
        "snacks",
        "beverages",
        "dry_groceries",
        "fresh_products",
        "frozen_products"
      ],
      "description": "Product category"
    },
    "rayon": {
      "type": "string",
      "enum": [
        "boissons",
        "snacks",
        "produits_frais",
        "congelateur",
        "caisse"
      ],
      "description": "Store section (rayon)"
    },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "Expiration date"
    },
    "quantity": {
      "type": "number",
      "description": "Quantity (optional)"
    },
    "order_status": {
      "type": "string",
      "enum": [
        "a_commander",
        "commande",
        "recu"
      ],
      "description": "Restocking order status (only for expired products)"
    },
    "order_date": {
      "type": "string",
      "format": "date",
      "description": "Order date for restocking"
    }
  },
  "required": [
    "name",
    "category",
    "expiration_date"
  ]
}