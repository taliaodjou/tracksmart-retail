{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du produit"
    },
    "marque": {
      "type": "string",
      "description": "Marque"
    },
    "barcode": {
      "type": "string",
      "description": "Code EAN / code-barres du produit"
    },
    "image_url": {
      "type": "string",
      "description": "URL de la photo du produit"
    },
    "etagere": {
      "type": "string",
      "description": "\u00c9tag\u00e8re (optionnel)"
    },
    "category": {
      "type": "string",
      "enum": [
        "snacks",
        "boissons",
        "congeles_poisson",
        "congeles_poulet",
        "produits_frais",
        "epicerie_seche",
        "confiseries",
        "conserves",
        "hygiene_beaute",
        "entretien_maison",
        "bebe",
        "animaux",
        "alcool",
        "tabac"
      ],
      "description": "Cat\u00e9gorie"
    },
    "rayon": {
      "type": "string",
      "description": "Rayon / Section personnalis\u00e9e"
    },
    "store_owner_email": {
      "type": "string",
      "description": "Email of the store owner \u2014 used to scope product to the entire store team"
    },
    "added_by_name": {
      "type": "string",
      "description": "Full name of the user who added this product"
    },
    "reception_date": {
      "type": "string",
      "format": "date",
      "description": "Date de r\u00e9ception"
    },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "DLC (Date limite de consommation)"
    },
    "action": {
      "type": "string",
      "enum": [
        "jeter",
        "a_recommander",
        "commande",
        "en_transition",
        "recu"
      ],
      "description": "Action si expir\u00e9"
    },
    "order_date": {
      "type": "string",
      "format": "date",
      "description": "Date de commande"
    },
    "quantity_thrown": {
      "type": "number",
      "description": "Quantit\u00e9 jet\u00e9e"
    },
    "price_chf": {
      "type": "number",
      "description": "Prix unitaire CHF"
    },
    "order_status": {
      "type": "string",
      "enum": [
        "a_commander",
        "commande",
        "recu"
      ],
      "description": "Statut commande"
    },
    "description": {
      "type": "string",
      "description": "Description optionnelle du produit",
      "maxLength": 1000
    },
    "discarded": {
      "type": "boolean",
      "default": false,
      "description": "Produit jet\u00e9 \u2014 exclu du stock actif mais conserv\u00e9 pour les analytiques et rapports de pertes"
    },
    "discarded_at": {
      "type": "string",
      "format": "date",
      "description": "Date \u00e0 laquelle le produit a \u00e9t\u00e9 jet\u00e9"
    }
  },
  "required": [
    "name",
    "expiration_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.store_owner_email": "{{user.email}}"
        },
        {
          "data.store_owner_email": "{{user.store_owner_email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.store_owner_email": "{{user.email}}"
        },
        {
          "data.store_owner_email": "{{user.store_owner_email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "$and": [
            {
              "data.store_owner_email": "{{user.email}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "manager"
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "data.store_owner_email": "{{user.store_owner_email}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "manager"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "$and": [
            {
              "data.store_owner_email": "{{user.email}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "manager"
                  }
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "data.store_owner_email": "{{user.store_owner_email}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "manager"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}