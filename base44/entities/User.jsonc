{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "inactive"
    },
    "subscription_start_date": {
      "type": "string",
      "format": "date"
    },
    "last_reminder_sent": {
      "type": "string"
    },
    "last_weekly_report": {
      "type": "string"
    },
    "phone_number": {
      "type": "string"
    },
    "report_channel": {
      "type": "string",
      "enum": [
        "email",
        "sms"
      ],
      "default": "email"
    },
    "shop_name": {
      "type": "string",
      "description": "Nom de la boutique"
    },
    "shop_size": {
      "type": "string",
      "enum": [
        "petite",
        "moyenne",
        "grande"
      ],
      "description": "Taille de la boutique"
    },
    "product_count_approx": {
      "type": "number",
      "description": "Nombre approximatif de produits"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    }
  }
}