{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "owner",
        "manager",
        "employee",
        "user"
      ],
      "default": "user",
      "description": "Platform role. 'admin'=TrackSmart admin, 'owner'=store owner, 'manager'=store manager, 'employee'=store employee, 'user'=legacy"
    },
    "store_owner_email": {
      "type": "string",
      "description": "Email of the store owner this user belongs to. Null for owners themselves."
    },
    "shop_name": {
      "type": "string",
      "description": "Nom de la boutique"
    },
    "phone_number": {
      "type": "string",
      "description": "Num\u00e9ro de t\u00e9l\u00e9phone"
    },
    "report_channel": {
      "type": "string",
      "enum": [
        "email",
        "sms"
      ],
      "default": "email"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "blocked"
      ],
      "default": "inactive"
    },
    "subscription_start_date": {
      "type": "string",
      "format": "date"
    },
    "last_reminder_sent": {
      "type": "string",
      "description": "Tag of last subscription reminder sent"
    },
    "last_expiry_reminders_sent": {
      "type": "string",
      "description": "JSON: {date, sent} tracking product expiry reminders sent today"
    },
    "last_weekly_report": {
      "type": "string",
      "description": "Date of last weekly report sent"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "email_unsubscribed": {
      "type": "boolean",
      "default": false,
      "description": "True if user unsubscribed from emails"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "accounting_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly"
      ],
      "default": "quarterly"
    },
    "accounting_delivery": {
      "type": "string",
      "enum": [
        "email",
        "whatsapp"
      ],
      "default": "email"
    },
    "accounting_email": {
      "type": "string"
    },
    "accounting_whatsapp": {
      "type": "string"
    },
    "accounting_auto_send": {
      "type": "boolean",
      "default": false
    },
    "admin_notified": {
      "type": "boolean",
      "default": false,
      "description": "True once admin has been notified of this user's first login"
    },
    "access_approved": {
      "type": "boolean",
      "default": false,
      "description": "True if admin explicitly approved access"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.store_owner_email": "{{user.email}}"
        },
        {
          "data.store_owner_email": "{{user.store_owner_email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "$and": [
            {
              "data.store_owner_email": "{{user.email}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "manager"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.store_owner_email": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "owner"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}