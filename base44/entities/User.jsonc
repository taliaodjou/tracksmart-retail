{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "shop_name": {
      "type": "string",
      "description": "Nom de la boutique"
    },
    "phone_number": {
      "type": "string",
      "description": "Num\u00e9ro de t\u00e9l\u00e9phone"
    },
    "report_channel": {
      "type": "string",
      "enum": [
        "email",
        "sms"
      ],
      "default": "email"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "inactive"
    },
    "subscription_start_date": {
      "type": "string",
      "format": "date"
    },
    "last_reminder_sent": {
      "type": "string",
      "description": "Tag of last subscription reminder sent"
    },
    "last_expiry_reminders_sent": {
      "type": "string",
      "description": "JSON: {date, sent} tracking product expiry reminders sent today"
    },
    "last_weekly_report": {
      "type": "string",
      "description": "Date of last weekly report sent"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    }
  }
}