{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "inactive"
    },
    "subscription_start_date": {
      "type": "string",
      "format": "date",
      "description": "Monthly renewal base date"
    },
    "phone_number": {
      "type": "string",
      "description": "Optional phone for SMS reports"
    },
    "report_channel": {
      "type": "string",
      "enum": [
        "email",
        "sms"
      ],
      "default": "email",
      "description": "Preferred channel for weekly reports"
    },
    "last_reminder_sent": {
      "type": "string",
      "description": "Tracks last reminder level sent (14d/7d/3d)"
    },
    "last_weekly_report": {
      "type": "string",
      "format": "date",
      "description": "Date of last weekly report"
    }
  }
}