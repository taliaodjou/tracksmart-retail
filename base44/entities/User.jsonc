{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "merchant",
        "owner",
        "manager",
        "employee",
        "consumer",
        "user"
      ],
      "default": "user",
      "description": "Platform role. 'admin'=TrackSmart Retail admin, 'merchant'/'owner'/'manager'/'employee'/'user'=Espace Boutique roles, 'consumer'=customer marketplace role."
    },
    "store_owner_email": {
      "type": "string",
      "description": "Email of the store owner this user belongs to. Null for owners themselves."
    },
    "contact_name": {
      "type": "string",
      "description": "Nom complet saisi pendant le questionnaire d'inscription"
    },
    "first_name": {
      "type": "string",
      "description": "Pr\u00e9nom de l'utilisateur"
    },
    "last_name": {
      "type": "string",
      "description": "Nom de l'utilisateur"
    },
    "shop_name": {
      "type": "string",
      "description": "Nom de la boutique"
    },
    "phone_number": {
      "type": "string",
      "description": "Num\u00e9ro de t\u00e9l\u00e9phone"
    },
    "address": {
      "type": "string",
      "description": "Adresse de la boutique pour la future d\u00e9couverte consumer"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude de la boutique pour la d\u00e9couverte par proximit\u00e9"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude de la boutique pour la d\u00e9couverte par proximit\u00e9"
    },
    "openingHours": {
      "type": "string",
      "description": "Horaires d'ouverture de la boutique, au format texte ou JSON"
    },
    "storeSize": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large",
        "unknown"
      ],
      "default": "unknown",
      "description": "Taille indicative de la boutique"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "Boutique active sur la plateforme"
    },
    "marketplaceVisibility": {
      "type": "string",
      "enum": [
        "hidden",
        "visible"
      ],
      "default": "hidden",
      "description": "Visibilit\u00e9 de la boutique dans la future exp\u00e9rience consumer"
    },
    "report_channel": {
      "type": "string",
      "enum": [
        "email",
        "sms"
      ],
      "default": "email"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "blocked"
      ],
      "default": "inactive"
    },
    "subscription_start_date": {
      "type": "string",
      "format": "date"
    },
    "last_reminder_sent": {
      "type": "string",
      "description": "Tag of last subscription reminder sent"
    },
    "last_expiry_reminders_sent": {
      "type": "string",
      "description": "JSON: {date, sent} tracking product expiry reminders sent today"
    },
    "last_weekly_report": {
      "type": "string",
      "description": "Date of last weekly report sent"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "email_unsubscribed": {
      "type": "boolean",
      "default": false,
      "description": "True if user unsubscribed from emails"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "accounting_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly"
      ],
      "default": "quarterly"
    },
    "accounting_delivery": {
      "type": "string",
      "enum": [
        "email",
        "whatsapp"
      ],
      "default": "email"
    },
    "accounting_email": {
      "type": "string"
    },
    "accounting_whatsapp": {
      "type": "string"
    },
    "accounting_auto_send": {
      "type": "boolean",
      "default": false
    },
    "admin_notified": {
      "type": "boolean",
      "default": false,
      "description": "True once admin has been notified of this user's first login"
    },
    "access_approved": {
      "type": "boolean",
      "default": false,
      "description": "True if admin explicitly approved access"
    },
    "business_type": {
      "type": "string",
      "enum": [
        "supermarche",
        "epicerie",
        "boulangerie",
        "boucherie",
        "pharmacie",
        "restaurant",
        "cafe_bar",
        "autre"
      ],
      "description": "Type de commerce"
    },
    "user_position": {
      "type": "string",
      "enum": [
        "owner",
        "manager",
        "employee"
      ],
      "description": "Position dans le commerce"
    },
    "city": {
      "type": "string",
      "description": "Ville du commerce"
    },
    "country": {
      "type": "string",
      "description": "Pays du commerce"
    },
    "preferred_lang": {
      "type": "string",
      "enum": [
        "fr",
        "en"
      ],
      "default": "fr",
      "description": "Langue pr\u00e9f\u00e9r\u00e9e de l'utilisateur"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.store_owner_email": "{{user.email}}"
        },
        {
          "data.store_owner_email": "{{user.store_owner_email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "$and": [
            {
              "data.store_owner_email": "{{user.email}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "manager"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.store_owner_email": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "owner"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}