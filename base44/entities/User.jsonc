{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user",
      "description": "User role"
    },
    "shop_name": {
      "type": "string",
      "description": "Store name"
    },
    "shop_size": {
      "type": "string",
      "enum": [
        "petite",
        "moyenne",
        "grande"
      ],
      "description": "Store size"
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "classic",
        "premium"
      ],
      "default": "classic",
      "description": "Subscription plan"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Subscription status"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "report_method": {
      "type": "string",
      "enum": [
        "email",
        "sms"
      ],
      "default": "email",
      "description": "Preferred report method"
    },
    "last_payment_date": {
      "type": "string",
      "format": "date",
      "description": "Last payment date"
    },
    "last_activity_date": {
      "type": "string",
      "description": "Last activity timestamp"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    }
  }
}