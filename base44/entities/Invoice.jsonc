{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "store_owner_email": {
      "type": "string",
      "description": "Email du propri\u00e9taire de la boutique"
    },
    "invoice_number": {
      "type": "string",
      "description": "Num\u00e9ro de facture (ex: INV-2026-0842)"
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "customer_name": {
      "type": "string",
      "description": "Nom du client"
    },
    "customer_address": {
      "type": "string",
      "description": "Adresse du client"
    },
    "customer_email": {
      "type": "string",
      "description": "Email de facturation du client"
    },
    "items": {
      "type": "string",
      "description": "JSON des lignes (description, qty, price)"
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "final"
      ],
      "default": "draft"
    }
  },
  "required": [
    "store_owner_email",
    "invoice_number",
    "customer_name",
    "items",
    "total",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.store_owner_email": "{{user.email}}"
        },
        {
          "data.store_owner_email": "{{user.data.store_owner_email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.store_owner_email": "{{user.email}}"
        },
        {
          "data.store_owner_email": "{{user.data.store_owner_email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.store_owner_email": "{{user.email}}"
        },
        {
          "data.store_owner_email": "{{user.data.store_owner_email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.store_owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}