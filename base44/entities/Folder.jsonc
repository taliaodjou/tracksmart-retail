{
  "name": "Folder",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du dossier"
    },
    "user_email": {
      "type": "string",
      "description": "Email du propri\u00e9taire"
    },
    "color": {
      "type": "string",
      "description": "Couleur du dossier (hex)",
      "default": "#C9A646"
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "Dossier syst\u00e8me non supprimable"
    }
  },
  "required": [
    "name",
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}