{
  "name": "StockMovementSummary",
  "type": "object",
  "properties": {
    "store_owner_email": {
      "type": "string",
      "description": "Email of the store owner for team scoping"
    },
    "product_id": {
      "type": "string",
      "description": "Linked Product record id"
    },
    "month": {
      "type": "string",
      "description": "Summary month in YYYY-MM format"
    },
    "total_receptions": {
      "type": "number",
      "default": 0
    },
    "total_ventes": {
      "type": "number",
      "default": 0
    },
    "movement_count": {
      "type": "number",
      "default": 0
    },
    "generated_at": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "store_owner_email",
    "product_id",
    "month"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.store_owner_email": "{{user.email}}"
        },
        {
          "data.store_owner_email": "{{user.store_owner_email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.store_owner_email": "{{user.email}}"
        },
        {
          "data.store_owner_email": "{{user.store_owner_email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.store_owner_email": "{{user.email}}"
        },
        {
          "data.store_owner_email": "{{user.store_owner_email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}